# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-opus-4-5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Prometheus
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT=30

# Loki
LOKI_URL=http://loki:3100
LOKI_TIMEOUT=30

# Jaeger / Tracing
JAEGER_URL=http://jaeger:16686
TRACING_TIMEOUT=30

# Kubernetes
KUBECONFIG_PATH=/root/.kube/config
K8S_IN_CLUSTER=false
K8S_NAMESPACE=default

# Vector Store
CHROMA_PERSIST_DIR=./data/embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Runbooks
RUNBOOKS_DIR=./data/runbooks

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Remediation Safety
AUTO_REMEDIATE=false
DRY_RUN=true
REMEDIATION_CONFIDENCE_THRESHOLD=0.85
RISK_THRESHOLD=medium

# Anomaly Detection
ANOMALY_CONTAMINATION=0.05
THRESHOLD_CPU_PERCENT=85.0
THRESHOLD_MEMORY_PERCENT=90.0
THRESHOLD_ERROR_RATE=0.05
THRESHOLD_LATENCY_P99_MS=2000.0