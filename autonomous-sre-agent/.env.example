# LLM Settings
GEMINI_API_KEY=enter your GEMINI_API_KEY
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Prometheus Endpoint
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=30

# Loki Endpoint
LOKI_URL=http://localhost:3100
LOKI_TIMEOUT=30

# Jaeger / Tracing Endpoint
JAEGER_URL=http://localhost:16686
TRACING_TIMEOUT=30

# Kubernetes Context
KUBECONFIG_PATH=C:\Users\username\.kube\config
K8S_IN_CLUSTER=false
K8S_NAMESPACE=default

# Vector Store
CHROMA_PERSIST_DIR=./data/embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Runbooks
RUNBOOKS_DIR=./data/runbooks

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Remediation Safety Settings
AUTO_REMEDIATE=false
DRY_RUN=true
REMEDIATION_CONFIDENCE_THRESHOLD=0.85
RISK_THRESHOLD=medium

# Anomaly Detection Thresholds
ANOMALY_CONTAMINATION=0.05
THRESHOLD_CPU_PERCENT=85.0
THRESHOLD_MEMORY_PERCENT=90.0
THRESHOLD_ERROR_RATE=0.05
THRESHOLD_LATENCY_P99_MS=2000.0
