{
	"uid": "autonomous-sre-agent",
	"title": "Autonomous SRE Agent",
	"schemaVersion": 38,
	"version": 1,
	"refresh": "30s",
	"timezone": "browser",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"timepicker": {
		"refresh_intervals": ["10s", "30s", "1m", "5m", "15m"],
		"time_options": ["5m", "15m", "1h", "6h", "12h", "24h"]
	},
	"templating": {
		"list": [
			{
				"name": "namespace",
				"label": "Namespace",
				"type": "textbox",
				"current": {"text": "default", "value": "default"}
			},
			{
				"name": "pod",
				"label": "Pod (regex)",
				"type": "textbox",
				"current": {"text": ".*", "value": ".*"}
			}
		]
	},
	"annotations": {
		"list": [
			{
				"builtIn": 1,
				"datasource": "-- Grafana --",
				"enable": true,
				"hide": true,
				"iconColor": "rgba(0, 211, 255, 1)",
				"name": "Annotations & Alerts",
				"type": "dashboard"
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "timeseries",
			"title": "CPU Usage (cores)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m])) by (pod)",
					"legendFormat": "{{pod}}",
					"refId": "A"
				}
			],
			"fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []},
			"options": {"legend": {"displayMode": "table", "placement": "bottom"}},
			"gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
		},
		{
			"id": 2,
			"type": "timeseries",
			"title": "Memory Usage (bytes)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"$pod\"}) by (pod)",
					"legendFormat": "{{pod}}",
					"refId": "A"
				}
			],
			"fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
			"options": {"legend": {"displayMode": "table", "placement": "bottom"}},
			"gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
		},
		{
			"id": 3,
			"type": "stat",
			"title": "HTTP Error Rate",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(rate(http_requests_total{namespace=\"$namespace\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"$namespace\"}[5m]))",
					"refId": "A"
				}
			],
			"fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2}, "overrides": []},
			"options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
			"gridPos": {"h": 6, "w": 6, "x": 0, "y": 8}
		},
		{
			"id": 4,
			"type": "timeseries",
			"title": "Pod Restarts",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "sum(kube_pod_container_status_restarts_total{namespace=\"$namespace\",pod=~\"$pod\"}) by (pod)",
					"legendFormat": "{{pod}}",
					"refId": "A"
				}
			],
			"fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
			"options": {"legend": {"displayMode": "table", "placement": "bottom"}},
			"gridPos": {"h": 6, "w": 18, "x": 6, "y": 8}
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "p99 Latency (ms)",
			"datasource": "Prometheus",
			"targets": [
				{
					"expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le)) * 1000",
					"refId": "A"
				}
			],
			"fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
			"gridPos": {"h": 8, "w": 24, "x": 0, "y": 14}
		},
		{
			"id": 6,
			"type": "logs",
			"title": "Recent Logs",
			"datasource": "Loki",
			"targets": [
				{
					"expr": "{namespace=\"$namespace\",pod=~\"$pod\"}",
					"refId": "A"
				}
			],
			"options": {"showLabels": false, "showTime": true, "wrapLogMessage": true},
			"gridPos": {"h": 10, "w": 24, "x": 0, "y": 22}
		}
	],
	"editable": true,
	"links": []
}
